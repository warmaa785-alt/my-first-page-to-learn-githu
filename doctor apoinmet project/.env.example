PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/bhabua_token
JWT_SECRET=replace-this-with-a-long-random-secret
ADMIN_PHONE=9000000099
ADMIN_PASSWORD=change-this-admin-password
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=qwen/qwen3.8-27b
# Optional SMS notifications only; patient OTP uses email and does not use Twilio.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# Development only: demo codes are returned by the API; keep false for production.
ALLOW_DEMO_OTP=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
# Patient login OTP is delivered by email through Gmail SMTP (no paid SMS provider).
# Create a Google App Password; do not use the Gmail account password.
FRONTEND_URL=http://localhost:3000
