PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/bhabua_token
JWT_SECRET=replace-this-with-a-long-random-secret
ADMIN_PHONE=9000000099
ADMIN_PASSWORD=change-this-admin-password
# Direct UPI (no gateway integration); admin must verify each transaction manually.
UPI_ID=your-business-upi-id@bank
UPI_PAYEE_NAME=Sehat Bhabua
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=qwen/qwen3.8-27b
# SMS notifications only; patient OTP uses email and does not use Twilio.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# Demo codes are disabled; real OTP uses the configured email provider.
ALLOW_DEMO_OTP=false
# Resend API for OTP and support email.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# For testing, onboarding@resend.dev can only send to your Resend account email.
# For other recipients, verify a sending domain in Resend and use its sender address.
RESEND_FROM_EMAIL=onboarding@resend.dev
# Optional Gmail SMTP fallback (requires network access to smtp.gmail.com).
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-gmail-app-password
# New patient questions are emailed here; replies are submitted in the admin dashboard.
SUPPORT_NOTIFICATION_EMAIL=warmaa785@gmail.com
# Create a Google App Password; do not use the Gmail account password.
FRONTEND_URL=http://localhost:3000
# Set APP_BASE_URL to the public app URL when deployed so email links open remotely.
APP_BASE_URL=http://localhost:3000
